{
  "manifest": 2,
  "id": "ai-scoring",
  "name": "AI 评分（魔塔）",
  "englishName": "Mota · AI scoring",
  "description": "客户端布阵评分：策略/队列/Worker 调度与本地布阵库。只加代码，不改玩法数据。",
  "version": "0.3.1",
  "app": ">=0.3.0 <0.4.0",
  "api": 2,
  "class": "trusted",
  "scope": [
    "room"
  ],
  "loadOrder": 10,
  "permissions": [
    "trusted.server"
  ],
  "entry": {
    "server": "host/noop.js"
  },
  "code": {
    "client": [
      "js/ai/scoringRunner.js",
      "js/ai/lineupStore.js"
    ],
    "data": []
  }
}
