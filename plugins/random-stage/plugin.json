{
  "manifest": 2,
  "id": "random-stage",
  "name": {
    "zh": "随机地图（房间层）"
  },
  "englishName": "Random Stage",
  "description": {
    "zh": "房间层的「随机地图」开关：默认**关**（整局同一张图，Boss 关也不换）；房主在开局前可以打开，打开后每回合从本难度的战场池换图。只用 code.lobby —— 换图本身发生在 mota 的 Match 里（它读这个房间选项），本插件不碰 code.match。"
  },
  "version": "0.1.0",
  "app": ">=0.3.0 <0.5.0",
  "api": 2,
  "authors": [
    {
      "name": "jingjiangze"
    }
  ],
  "license": "GPL-3.0-or-later",
  "class": "trusted",
  "scope": [
    "room"
  ],
  "permissions": [
    "trusted.server"
  ],
  "entry": {
    "server": "host/noop.js"
  },
  "code": {
    "lobby": "server/lobby.js"
  },
  "needs": [
    "code.lobby"
  ]
}
