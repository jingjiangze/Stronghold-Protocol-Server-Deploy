{
  "manifest": 2,
  "id": "xie-room",
  "name": {
    "zh": "协同共竞（房间层）"
  },
  "englishName": "Joint Op Rooms",
  "description": {
    "zh": "协同共竞的房间层规则集：记住房主选的 `variant: xie`、把它平铺进 room.state（客户端据此切换到协同共竞房间页）、并把对局 id 映射成数据表里的 mode_xie_<difficulty>。对局本体仍在 mota。"
  },
  "version": "0.1.0",
  "app": ">=0.3.0 <0.5.0",
  "api": 2,
  "authors": [
    {
      "name": "jingjiangze"
    }
  ],
  "license": "GPL-3.0-or-later",
  "class": "trusted",
  "scope": [
    "room"
  ],
  "permissions": [
    "trusted.server"
  ],
  "entry": {
    "server": "host/noop.js"
  },
  "code": {
    "lobby": "server/xieLobby.js"
  },
  "needs": [
    "code.lobby",
    "room.option.variant"
  ]
}
