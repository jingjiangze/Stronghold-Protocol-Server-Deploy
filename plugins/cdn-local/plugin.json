{
  "manifest": 2,
  "id": "cdn-local",
  "name": {
    "zh": "素材门牌（CDN 指向）"
  },
  "englishName": "Asset CDN Pointer",
  "description": {
    "zh": "决定缺失素材（/assets /fonts /media）往哪个 CDN 302：源顺序、路径白名单、例外表、?sp_source 覆盖、健康探测与排名表全在本插件内，核心只负责「本机没有就去问插件」。换 CDN = 改本插件的 config/sources.json，不动核心。"
  },
  "version": "0.1.0",
  "app": ">=0.3.0 <0.5.0",
  "api": 2,
  "authors": [
    {
      "name": "jingjiangze"
    }
  ],
  "license": "GPL-3.0-or-later",
  "class": "trusted",
  "scope": [
    "room"
  ],
  "permissions": [
    "trusted.server"
  ],
  "entry": {
    "server": "host/noop.js"
  },
  "code": {
    "static": "server/assetJump.js"
  },
  "needs": [
    "code.static",
    "csp.sources"
  ]
}
